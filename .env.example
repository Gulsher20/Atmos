# ============================================
# Weather Intelligence PWA - Environment Variables
# ============================================
# Copy this file to .env and fill in values

# --- Database ---
# The running app uses a local SQLite file. That file is gitignored.
DATABASE_PATH=data/weather.db
# Placeholder only. Do not put a real username or password here.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/weather_intelligence

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Weather Providers ---
# Open-Meteo: No API key required for non-commercial use
WEATHERAPI_KEY=
OPENWEATHER_API_KEY=

# --- Push Notifications (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Geocoding ---
NOMINATIM_USER_AGENT=WeatherIntelligencePWA/1.0

# --- Server ---
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug
